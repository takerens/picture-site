# Copy to .env.local (never committed) and fill in from Cloudflare > R2.

# Public URL of your bucket (r2.dev address or custom domain), no trailing slash.
VITE_PHOTO_BASE=

# Only needed for `npm run add-trip`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: add-trip refuses to upload past this many GB (default 9.5, just under R2's 10GB free tier).
# R2_STORAGE_LIMIT_GB=9.5
